{
  "name": "@opticast/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p api dashboard",
    "api": "nx serve api",
    "dashboard": "nx serve dashboard",
    "scanner": "cd packages/scanner && EXPO_NO_METRO_WORKSPACE_ROOT=1 yarn expo start",
    "scanner:prebuild": "nx prebuild scanner --platform ios --clean",
    "scanner:ios": "nx run-ios scanner --args=\"--device\"",
    "scanner:ios:release": "cd packages/scanner && EXPO_NO_METRO_WORKSPACE_ROOT=1 npx expo run:ios --device --configuration Release",
    "scanner:build:dev": "nx build scanner --platform ios --profile development",
    "scanner:build:preview": "nx build scanner --platform ios --profile preview",
    "scanner:build": "nx build scanner --platform ios --profile production",
    "scanner:submit": "nx submit scanner --args=\"--platform ios\"",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "bundle-scanner": "nx export scanner --platform ios --output-dir dist/scanner-export",
    "verify": "nx run-many -t typecheck test && nx run-many -t build -p protocol api dashboard",
    "measure:payload": "MEASURE_PAYLOAD=1 nx test api --skip-nx-cache"
  },
  "private": true,
  "packageManager": "yarn@4.9.4",
  "devDependencies": {
    "@expo/cli": "~56.1.14",
    "@nx/esbuild": "23.1.0",
    "@nx/expo": "^23.1.0",
    "@nx/js": "23.1.0",
    "@nx/node": "^23.1.0",
    "@nx/react": "^23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "babel-preset-expo": "~56.0.14",
    "esbuild": "^0.27.0",
    "jiti": "2.4.2",
    "jsqr": "^1.4.0",
    "nx": "23.1.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@expo/metro": "~56.0.0",
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "~15.1.0",
    "expo": "~56.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "express": "^5.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0"
  }
}
