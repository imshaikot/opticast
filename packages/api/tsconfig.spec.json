{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    // Tests run through Vitest, which resolves like a bundler rather than like
    // Node's ESM loader. Matching that here keeps CJS-only test-only deps such
    // as `jsqr` importable with a plain default import.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "../protocol/tsconfig.lib.json" }
  ]
}
